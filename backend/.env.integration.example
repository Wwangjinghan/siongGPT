# Local, isolated Phase 4.5 databases from infra/docker-compose.test.yml only.
# Supply the password and complete URLs at runtime; do not commit either value.
SIONGGPT_TEST_DB_PASSWORD=
TEST_DATABASE_URL=
TEST_MIGRATION_DATABASE_URL=
ALLOW_DESTRUCTIVE_DB_TESTS=false

# Set this to an approved directory outside the repository.
EMBEDDING_MODEL_LOCAL_PATH=<outside-repository-model-directory>
EMBEDDING_ALLOW_DOWNLOAD=false
